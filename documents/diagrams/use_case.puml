@startuml
left to right direction

actor "Сотрудник приюта" as Employee
actor "Администратор" as Admin

rectangle "Система учёта животных в приюте" {

    usecase "Вход в систему" as UC1
    usecase "Регистрация пользователя" as UC2

    usecase "Просмотр списка животных" as UC3
    usecase "Добавление животного" as UC4
    usecase "Изменение данных животного" as UC5
    usecase "Удаление животного" as UC6

    usecase "Просмотр списка владельцев" as UC7
    usecase "Добавление владельца" as UC8
    usecase "Изменение данных владельца" as UC9
    usecase "Удаление владельца" as UC10

    usecase "Просмотр записей о пристройстве" as UC11
    usecase "Добавление записи о пристройстве" as UC12
    usecase "Изменение записи о пристройстве" as UC13
    usecase "Удаление записи о пристройстве" as UC14

    usecase "Управление сотрудниками" as UC15
    usecase "Просмотр списка сотрудников" as UC16
    usecase "Добавление сотрудника" as UC17
    usecase "Изменение данных сотрудника" as UC18
    usecase "Удаление сотрудника" as UC19
}

Employee --> UC1
Employee --> UC2
Employee --> UC3
Employee --> UC4
Employee --> UC5
Employee --> UC6
Employee --> UC7
Employee --> UC11

Admin --> UC1
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15

UC15 .> UC16 : <<include>>
UC15 .> UC17 : <<include>>
UC15 .> UC18 : <<include>>
UC15 .> UC19 : <<include>>

@enduml
